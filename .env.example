# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#
# Everything here is optional. Without any of it the console runs fully
# offline and the case narrative falls back to a deterministic template.

# Enables the analyst case narrative ("Write the case" in the console).
# Costs roughly half a cent per narrative on the default model.
ANTHROPIC_API_KEY=

# The model that writes the narrative. Defaults to claude-haiku-4-5, which is
# the right size for two paragraphs over an evidence block that has already
# been assembled and quantified. Set to claude-opus-5 for a pitch if you want
# the prose to read better; it costs about five times as much per call.
# FRAUD_NARRATIVE_MODEL=claude-haiku-4-5

# Which scenario the scorer serves. run.ps1 sets this from -Scenario, so you
# only need it when starting uvicorn by hand.
# FRAUD_DATA=data/moderate
# FRAUD_MODELS=models
