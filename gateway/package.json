{
  "name": "fraud-gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Fastify gateway and mock merchant/issuer services",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "merchant": "node dist/institution.js --role merchant --institution inst_00 --port 8101",
    "issuer": "node dist/institution.js --role issuer --institution inst_01 --port 8102",
    "dev": "tsc && node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
